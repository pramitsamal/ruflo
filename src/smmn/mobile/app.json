{
  "expo": {
    "name": "SMMN",
    "slug": "smmn",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "smmn",
    "icon": "./assets/icon.png",
    "splash": { "image": "./assets/splash.png", "backgroundColor": "#030712" },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#030712"
      },
      "package": "com.smmn.app"
    },
    "plugins": ["expo-router"],
    "experiments": { "typedRoutes": true }
  }
}
